{
	"schemaVersion": 1,
	"id": "mc-engine",
	"version": "${version}",
	"name": "MC Engine",
	"description": "For creating worlds and stories.",
	"authors": [
		"Scotticles"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mc-engine/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.scotticles.mcengine.MCEngine"
		],
		"client": [
			"net.scotticles.mcengine.MCEngineClient"
		],
		"fabric-datagen": [
			"net.scotticles.mcengine.MCEngineDataGenerator"
		]
	},
	"mixins": [
		"mc-engine.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
